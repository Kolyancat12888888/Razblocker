<Window x:Class="HFL.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HFL Razbloker — Native DNS Edition" Height="620" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Modern Cyberpunk Button Style -->
        <Style x:Key="PowerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="OuterGlow" Width="140" Height="140" Fill="#0F172A" Stroke="#38BDF8" StrokeThickness="3">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#38BDF8" BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️ HFL Razbloker" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TRANSPARENT DNS EDITION" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="LicenseBadge" Background="#13271F" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                    <TextBlock x:Name="LicenseText" Text="🟢 Лицензия: Бессрочно" FontSize="12" Foreground="#34D399" FontWeight="Medium"/>
                </Border>
                <Button Content="⚙️ Ключ / Сертификаты" Background="#1E293B" Foreground="#94A3B8" Padding="10,6" Click="SettingsButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Power Button -->
            <Border Grid.Column="0" Background="#0F172A" CornerRadius="12" Padding="20" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,12,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="TogglePowerButton" Style="{StaticResource PowerButtonStyle}" Click="TogglePower_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="PowerIcon" Text="⚡" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PowerButtonText" Text="ВКЛЮЧИТЬ" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="ConnectionStatusText" Text="Отключено" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,18,0,14"/>

                    <Border Background="#131D2F" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Режим работы:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="🔒 Прямой DNS перехват без изменения настроек сети" FontSize="12" Foreground="#38BDF8" FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right Column: Live Metrics -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Padding="20" BorderBrush="#1E293B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📊 Статус сетевого шлюза и DNS" FontSize="14" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,14"/>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Latency -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#131D2F" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="📶 Пинг до сервера DNS" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="PingText" Text="— ms" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                <TextBlock Text="31.77.8.9:53 (Прямой DoH)" FontSize="10" Foreground="#475569" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Strategy -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#131D2F" CornerRadius="8" Padding="14" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🎯 Активный статус" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="StrategyText" Text="Отключено" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Local / Internal Domains -->
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#131D2F" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🌐 Внутренние зоны (.local / .internal)" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="hfl-control-panel.internal, *.internal, *.local" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🟢 Готов к перехвату" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Log Console -->
        <Border Grid.Row="2" Background="#06090E" CornerRadius="8" Padding="12" BorderBrush="#1E293B" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="🖥️ Журнал работы HFL DNS Engine:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox" Background="Transparent" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
