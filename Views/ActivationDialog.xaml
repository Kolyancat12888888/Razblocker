<Window x:Class="HFL.Client.Views.ActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HFL Razbloker Enterprise — Ключ и SSL Сертификаты" 
        Height="470" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0F19"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🛡️ HFL Razbloker Enterprise" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Управление лицензионным ключом и SSL-сертификатами шлюза" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock Text="Лицензионный ключ (HFL-XXXX-XXXX-XXXX):" FontWeight="Medium" Margin="0,0,0,6" Foreground="#CBD5E1" FontSize="12"/>
            <TextBox x:Name="KeyTextBox" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" FontSize="13" FontFamily="Consolas" BorderThickness="1"/>

            <!-- HWID info -->
            <Border Background="#131D2F" CornerRadius="6" Padding="10" Margin="0,10,0,0" BorderBrush="#1E293B" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ваш аппаратный идентификатор (HWID):" FontSize="10" Foreground="#64748B"/>
                        <TextBlock x:Name="HwidText" Text="HWID-XXXX-XXXX" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="📋 Скопировать" Background="#1E293B" Padding="8,4" FontSize="11" Click="CopyHwid_Click"/>
                </Grid>
            </Border>

            <!-- SSL Certificates Control Section -->
            <Border Background="#111827" CornerRadius="6" Padding="12" Margin="0,12,0,0" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔐 SSL Сертификаты (*.local, *.internal):" FontSize="11" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock Text="Управление доверием сертификатов в хранилище Windows" FontSize="10" Foreground="#6B7280" Margin="0,2,0,8"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📥 Добавить сертификаты" Background="#059669" FontSize="11" Padding="6,8" Click="InstallCerts_Click"/>
                        <Button Grid.Column="2" Content="🗑️ Удалить сертификаты" Background="#DC2626" FontSize="11" Padding="6,8" Click="UninstallCerts_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Text="" Foreground="#F87171" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Action Button -->
        <Button Grid.Row="2" x:Name="ActivateButton" Content="⚡ Сохранить и активировать ключ" Height="42" FontSize="13" Click="Activate_Click"/>
    </Grid>
</Window>
